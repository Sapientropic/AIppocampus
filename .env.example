# AIppocampus safe environment template.
# Copy to .env only for local shell/tooling setup. Do not commit .env.
# Canonical environment matrix:
# docs/guides/public-api.md#environment-configuration-matrix

# Storage and discovery. Leave blank to use built-in defaults.
AIPPOCAMPUS_HOME=
AIPPOCAMPUS_REGISTRY_DIR=
AIPPOCAMPUS_GENERIC_IMPORT_DIR=
CODEX_HOME=

# Optional vault projection. Treat local paths and branding/content source paths as private.
AIPPOCAMPUS_VAULT=
AIPPOCAMPUS_STYLE_SOURCE=
AIPPOCAMPUS_SCRIPT_SOURCE=
AIPPOCAMPUS_SITE_MARK=
AIPPOCAMPUS_SITE_TITLE=

# Object storage sync. Values can reveal infrastructure; credentials stay blank.
AIPPOCAMPUS_OBJECT_STORE_URL=
AIPPOCAMPUS_OBJECT_PREFIX=
AIPPOCAMPUS_OBJECT_PROVIDER=
AIPPOCAMPUS_OBJECT_BUCKET=
AIPPOCAMPUS_OBJECT_REGION=
AIPPOCAMPUS_OBJECT_ACCOUNT_ID=
AIPPOCAMPUS_OBJECT_STORE_TOKEN=
AIPPOCAMPUS_OBJECT_ACCESS_KEY_ID=
AIPPOCAMPUS_OBJECT_SECRET_ACCESS_KEY=
AIPPOCAMPUS_OBJECT_SESSION_TOKEN=

# Encrypted sync tooling. Use private local paths only in your untracked .env.
AIPPOCAMPUS_AGE_BIN=
AIPPOCAMPUS_AGE_KEYGEN_BIN=

# Hook and recall budgets. Numeric examples are safe; tune privately.
AIPPOCAMPUS_PROMPT_HOOK_BUDGET_MS=250
AIPPOCAMPUS_LIFECYCLE_HOOK_BUDGET_MS=1000
AIPPOCAMPUS_PROMPT_SKIP_TELEMETRY=1
AIPPOCAMPUS_SEMANTIC_GATE=off
AIPPOCAMPUS_PROMPT_SEMANTIC_TIMEOUT=
AIPPOCAMPUS_SEMANTIC_TIMEOUT=
AIPPOCAMPUS_SEMANTIC_TEMPERATURE=
AIPPOCAMPUS_SEMANTIC_CACHE_TTL=
AIPPOCAMPUS_SEMANTIC_CATALOG_LIMIT=
AIPPOCAMPUS_SEMANTIC_TRIGGER_LIMIT=

# Warm ambient recall and detached background limits.
AIPPOCAMPUS_WARM_RECALL_TIMEOUT=
AIPPOCAMPUS_WARM_RECALL_CATALOG_LIMIT=
AIPPOCAMPUS_WARM_RECALL_MAX_WORKERS=
AIPPOCAMPUS_WARM_RECALL_BACKGROUND=
AIPPOCAMPUS_DETACHED_WARM_TIMEOUT=
AIPPOCAMPUS_DETACHED_WARM_PREFIX_CACHE_WARMUP_SCOUTS=
AIPPOCAMPUS_DETACHED_WARM_PREFIX_CACHE_WARMUP_DELAY=

# Optional DeepSeek route. External-model routes are never required.
AIPPOCAMPUS_DEEPSEEK_FLASH_MODEL=
AIPPOCAMPUS_DEEPSEEK_PRO_MODEL=
AIPPOCAMPUS_DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=

# Optional OpenAI-compatible route. Keep referenced API-key values blank here.
AIPPOCAMPUS_OPENAI_COMPAT_ROUTE=
AIPPOCAMPUS_OPENAI_COMPAT_PROVIDER=
AIPPOCAMPUS_OPENAI_COMPAT_MODEL=
AIPPOCAMPUS_OPENAI_COMPAT_BASE_URL=
AIPPOCAMPUS_OPENAI_COMPAT_API_KEY_ENV=
AIPPOCAMPUS_OPENAI_COMPAT_CONCURRENCY=
AIPPOCAMPUS_OPENAI_COMPAT_SUPPORTS_JSON=
AIPPOCAMPUS_OPENAI_COMPAT_SUPPORTS_USER_ID=
AIPPOCAMPUS_OPENAI_COMPAT_SUPPORTS_THINKING=
AIPPOCAMPUS_OPENAI_COMPAT_CACHE_METRICS_KIND=
LOCAL_OPENAI_COMPAT_API_KEY=

# Background jobs, Dream/research delivery, and planning automation.
AIPPOCAMPUS_SUBCONSCIOUS_HOOK=
AIPPOCAMPUS_SUBCONSCIOUS_CONCURRENCY=
AIPPOCAMPUS_SUBCONSCIOUS_JOB_CONCURRENCY=
AIPPOCAMPUS_SUBCONSCIOUS_SAMPLES_PER_JOB=
AIPPOCAMPUS_DREAM_DELIVERY_MODE=
AIPPOCAMPUS_DREAM_SHADOW_AB=
AIPPOCAMPUS_DREAM_SHADOW_AB_SALT=
AIPPOCAMPUS_DREAM_ROLLOUT_RATE=
AIPPOCAMPUS_PROJECTS_TOKEN=
GH_TOKEN=
GITHUB_REPOSITORY=
AIPPOCAMPUS_PROJECT_OWNER=
AIPPOCAMPUS_PROJECT_NUMBER=
